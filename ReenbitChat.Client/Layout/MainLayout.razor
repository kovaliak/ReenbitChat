@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using ReenbitChat.Shared.Services
@using ReenbitChat.Shared.Dtos.RoomDto
@inject NavigationManager Nav
@inject IRoomService RoomService
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<AuthorizeView>
    <Authorized>
        <div class="d-flex vh-100 overflow-hidden">
            <nav class="d-flex flex-column bg-dark text-white p-3 shadow-sm" style="width: 260px;">
                
                <a href="/" class="d-flex align-items-center mb-4 text-white text-decoration-none">
                    <span class="fs-4 fw-bold">🚀 Reenbit Chat</span>
                </a>
                
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item mb-2">
                        <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All">
                            <i class="bi bi-house-door me-2"></i> Home
                        </NavLink>
                    </li>
                    
                    <li class="mt-3 mb-2 text-secondary text-uppercase" style="font-size: 0.8rem; font-weight: bold;">
                        Rooms
                    </li>
                    @if (rooms != null && rooms.Any())
                    {
                        @foreach (var room in rooms)
                        {
                            <li class="nav-item">
                                <NavLink class="nav-link text-white opacity-75" href="@($"/chat/{room.Name}")">
                                    <i class="bi bi-hash me-1"></i> @room.Name
                                </NavLink>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="text-muted small ps-3">No rooms yet...</li>
                    }
                </ul>

                <hr class="text-secondary">
                
                <ul class="nav nav-pills flex-column">
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/profile">
                            <i class="bi bi-person-circle me-2"></i> Profile
                        </NavLink>
                    </li>
                </ul>
            </nav>

            <main class="flex-grow-1 overflow-auto bg-light">
                <div class="p-4">
                    @Body
                </div>
            </main>
        </div>
    </Authorized>
    
    <NotAuthorized>
        <div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
            <div class="card shadow-lg p-4" style="max-width: 450px; width: 100%; border-radius: 15px;">
                <h2 class="text-center mb-4 fw-bold text-primary">Reenbit Chat</h2>
                @Body
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<RoomResponse> rooms = new();

    protected override async Task OnInitializedAsync()
    {
        RoomService.OnRoomsUpdated += ReloadRooms;
        
        await LoadRoomsAsync();
    }

    private async void ReloadRooms()
    {
        await LoadRoomsAsync();
        
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadRoomsAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is { IsAuthenticated: true })
        {
            try 
            {
                rooms = await RoomService.GetRoomsAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }

    public void Dispose()
    {
        RoomService.OnRoomsUpdated -= ReloadRooms;
    }
}